{
  "buildCommand": "if [ \"$(git rev-parse --is-shallow-repository)\" = \"true\" ]; then git fetch --unshallow; fi && pnpm build:edgeone",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "nodeVersion": "22.17.1",
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    }
  ]
}
